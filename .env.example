# -------------------------------------------------------------
# FIT TRAINING / COMBAT TRAINING — Configurazione Locale (.env.example)
# Copia questo file in un nuovo file nominato ".env" e compila i valori.
# -------------------------------------------------------------

# --- CONFIGURAZIONE SUPABASE (Richiesto per sincronizzazione/account) ---
# Ottieni questi parametri dalla dashboard di Supabase: Project Settings > API
VITE_SUPABASE_URL=https://tuo-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=tuo-anon-public-key

# --- FUNZIONALITÀ DI NEGOZIO / PREMIUM (Opzionali) ---
# Client ID di PayPal per mostrare i pulsanti di pagamento dello store nel frontend
VITE_PAYPAL_CLIENT_ID=tuo-paypal-client-id

# --- CONFIGURAZIONI BACKEND / ENDPOINT API (Opzionali per l'esecuzione locale di base) ---
# Nota: Questi sono richiesti se esegui anche gli endpoint serverless in api/ (es. tramite Vercel CLI)
SUPABASE_URL=https://tuo-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tua-service-role-key-privata
# ANTHROPIC_API_KEY=your-anthropic-claude-api-key # Per le funzioni AI (es. generazione schede/nutrizione)
# STRIPE_SECRET_KEY=your-stripe-secret-key # Per pagamenti Stripe nello store
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_SECRET=your-paypal-secret-key

# --- CONFIGURAZIONE ADMIN ---
# Lista di email separate da virgola autorizzate come amministratori (escluse dal codice sorgente)
# VITE_ADMIN_EMAILS=super.pippo.candy@gmail.com
